{
	"name": "@dialecte/playground",
	"version": "0.1.3",
	"description": "Dialecte - Playground",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dialecte/playground.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "run-p type-check \"build-only {@}\" --",
		"preview": "vite preview",
		"build-only": "vite build",
		"//====== TEST ======//": "",
		"test": "vitest run",
		"test:watch": "vitest",
		"//====== CHECK ======//": "",
		"check": "run-p type-check lint:check format:check",
		"type-check": "vue-tsc --build",
		"lint:check": "oxlint",
		"lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt"
	},
	"dependencies": {
		"@dialecte/core": "^0.5.1",
		"@dialecte/scl": "^0.4.0",
		"@guolao/vue-monaco-editor": "^1.6.0",
		"@tailwindcss/vite": "^4.2.1",
		"@vueuse/core": "^14.1.0",
		"marked": "^18.0.13",
		"monaco-editor": "^0.55.1",
		"pinia": "^3.0.4",
		"reka-ui": "^2.8.2",
		"tailwindcss": "^4.2.1",
		"vue": "^3.5.26"
	},
	"devDependencies": {
		"@tsconfig/node24": "^24.0.3",
		"@types/node": "^24.10.4",
		"@vitejs/plugin-vue": "^6.0.3",
		"@vue/tsconfig": "^0.8.1",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.38.0",
		"oxlint": "~1.53.0",
		"oxlint-tsgolint": "^0.16.0",
		"prettier": "^3.8.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-vue-devtools": "^8.0.5",
		"vitest": "^4.1.11",
		"vue-tsc": "^3.2.2"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
